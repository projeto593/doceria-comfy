{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Public storefront metadata for an artisanal confectionery without any PII.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the confectionery.",
          "minLength": 1,
          "maxLength": 45
        },
        "ownerDisplayName": {
          "type": "string",
          "description": "Display name of the confectioner.",
          "minLength": 1,
          "maxLength": 50
        },
        "city": {
          "type": "string",
          "description": "City and state label (e.g., São Paulo, SP).",
          "minLength": 1,
          "maxLength": 80
        },
        "segment": {
          "type": "string",
          "description": "Confectionery segment label.",
          "minLength": 1,
          "maxLength": 60
        },
        "plan": {
          "type": "string",
          "description": "Subscription plan label.",
          "minLength": 1,
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "description": "Store approval and operational status.",
          "enum": ["active", "pending_approval", "blocked"],
          "minLength": 6,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "name",
        "ownerDisplayName",
        "city",
        "segment",
        "plan",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreAccount": {
      "title": "StoreAccount",
      "description": "Isolated private PII, contact details, PIX key, and access credentials for a store.",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string",
          "description": "ID of the linked Store document.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Registered Gmail / email address of the store owner.",
          "minLength": 3,
          "maxLength": 60
        },
        "phone": {
          "type": "string",
          "description": "Formatted 11-digit WhatsApp phone number.",
          "minLength": 8,
          "maxLength": 20
        },
        "pixKey": {
          "type": "string",
          "description": "PIX payment key for the confectionery.",
          "minLength": 0,
          "maxLength": 80
        },
        "loginPassword": {
          "type": "string",
          "description": "Access password generated by Super Admin upon store approval.",
          "minLength": 0,
          "maxLength": 40
        },
        "blockReason": {
          "type": "string",
          "description": "Administrative suspension note when store is blocked.",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAtLabel": {
          "type": "string",
          "description": "Formatted pt-BR registration date.",
          "minLength": 1,
          "maxLength": 30
        },
        "approvedAtLabel": {
          "type": "string",
          "description": "Formatted pt-BR approval date.",
          "minLength": 0,
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "storeId",
        "ownerUid",
        "email",
        "phone",
        "pixKey",
        "loginPassword",
        "blockReason",
        "createdAtLabel",
        "approvedAtLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Confectionery catalog product item belonging to a store.",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string",
          "description": "Parent store ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Product display name.",
          "minLength": 1,
          "maxLength": 60
        },
        "price": {
          "type": "number",
          "description": "Unit price in BRL."
        },
        "unit": {
          "type": "string",
          "description": "Serving or box unit description.",
          "minLength": 1,
          "maxLength": 35
        },
        "description": {
          "type": "string",
          "description": "Ingredients and product description.",
          "minLength": 0,
          "maxLength": 500
        },
        "prepTimeHours": {
          "type": "number",
          "description": "Estimated preparation time in hours."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the product is active on the digital menu."
        },
        "tag": {
          "type": "string",
          "description": "Optional highlight badge.",
          "minLength": 0,
          "maxLength": 30
        },
        "emoji": {
          "type": "string",
          "description": "Fallback sweet emoji.",
          "minLength": 0,
          "maxLength": 16
        },
        "imageUrl": {
          "type": "string",
          "description": "Compressed product photo data URL or HTTPS image URL.",
          "minLength": 0,
          "maxLength": 400000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "storeId",
        "ownerUid",
        "name",
        "price",
        "unit",
        "description",
        "prepTimeHours",
        "active",
        "tag",
        "emoji",
        "imageUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer sweet order belonging to a store.",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string",
          "description": "Parent store ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "description": "Firebase Auth UID of the user who created the order.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "description": "Human-readable order code (e.g., #1049).",
          "minLength": 1,
          "maxLength": 20
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name.",
          "minLength": 1,
          "maxLength": 80
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer WhatsApp phone.",
          "minLength": 0,
          "maxLength": 25
        },
        "customerInitials": {
          "type": "string",
          "description": "2-letter avatar initials.",
          "minLength": 1,
          "maxLength": 4
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order value in BRL."
        },
        "status": {
          "type": "string",
          "description": "Production workflow status.",
          "enum": ["pending", "in_production", "ready", "delivered"],
          "minLength": 5,
          "maxLength": 20
        },
        "deliveryDate": {
          "type": "string",
          "description": "Requested delivery or pickup schedule.",
          "minLength": 1,
          "maxLength": 60
        },
        "deliveryType": {
          "type": "string",
          "description": "Pickup or delivery method.",
          "enum": ["retirada", "entrega"],
          "minLength": 7,
          "maxLength": 10
        },
        "paymentStatus": {
          "type": "string",
          "description": "Order payment state.",
          "enum": ["pago", "pendente", "50_sinal"],
          "minLength": 4,
          "maxLength": 12
        },
        "notes": {
          "type": "string",
          "description": "Custom cake message, delivery address, or packaging instructions.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAtIso": {
          "type": "string",
          "description": "ISO date string for reporting.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "storeId",
        "ownerUid",
        "createdByUid",
        "orderNumber",
        "customerName",
        "customerPhone",
        "customerInitials",
        "totalAmount",
        "status",
        "deliveryDate",
        "deliveryType",
        "paymentStatus",
        "notes",
        "createdAtIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual line item belonging to an Order inside a store.",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string",
          "description": "Parent store ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderId": {
          "type": "string",
          "description": "Linked Order document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUid": {
          "type": "string",
          "description": "Firebase Auth UID of the order creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "description": "Referenced catalog product ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "description": "Snapshot of product name at order time.",
          "minLength": 1,
          "maxLength": 80
        },
        "quantity": {
          "type": "number",
          "description": "Ordered item quantity."
        },
        "unitPrice": {
          "type": "number",
          "description": "Unit price in BRL at order time."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "storeId",
        "orderId",
        "ownerUid",
        "createdByUid",
        "productId",
        "productName",
        "quantity",
        "unitPrice",
        "createdAt",
        "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer CRM record isolated per store.",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string",
          "description": "Parent store ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Customer full name.",
          "minLength": 1,
          "maxLength": 80
        },
        "initials": {
          "type": "string",
          "description": "2-letter avatar initials.",
          "minLength": 1,
          "maxLength": 4
        },
        "phone": {
          "type": "string",
          "description": "Customer WhatsApp phone.",
          "minLength": 0,
          "maxLength": 25
        },
        "email": {
          "type": "string",
          "description": "Customer email address.",
          "minLength": 0,
          "maxLength": 80
        },
        "address": {
          "type": "string",
          "description": "Delivery address.",
          "minLength": 0,
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "description": "Customer preferences and allergy notes.",
          "minLength": 0,
          "maxLength": 500
        },
        "favoriteItem": {
          "type": "string",
          "description": "Most ordered or preferred sweet.",
          "minLength": 0,
          "maxLength": 80
        },
        "totalOrders": {
          "type": "number",
          "description": "Cumulative order count."
        },
        "totalSpent": {
          "type": "number",
          "description": "Cumulative spend in BRL."
        },
        "lastOrderDate": {
          "type": "string",
          "description": "Label of most recent order.",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "storeId",
        "ownerUid",
        "name",
        "initials",
        "phone",
        "email",
        "address",
        "notes",
        "favoriteItem",
        "totalOrders",
        "totalSpent",
        "lastOrderDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminSetting": {
      "title": "AdminSetting",
      "description": "Isolated Super Administrator credentials and security configuration.",
      "type": "object",
      "properties": {
        "adminEmail": {
          "type": "string",
          "format": "email",
          "description": "Verified Super Administrator email address.",
          "minLength": 3,
          "maxLength": 60
        },
        "adminPassword": {
          "type": "string",
          "description": "Custom Super Administrator access password.",
          "minLength": 4,
          "maxLength": 40
        },
        "updatedAtLabel": {
          "type": "string",
          "description": "Formatted pt-BR update date.",
          "minLength": 1,
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "adminEmail",
        "adminPassword",
        "updatedAtLabel",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Public confectionery storefront profiles without PII."
    },
    "/storeAccounts/{storeId}": {
      "schema": "StoreAccount",
      "description": "Private store contact PII, PIX key, and approval credentials."
    },
    "/adminSettings/{settingId}": {
      "schema": "AdminSetting",
      "description": "Isolated Super Administrator credentials restricted strictly to the verified admin."
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": "Product",
      "description": "Catalog sweets and products belonging to a confectionery."
    },
    "/stores/{storeId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders placed for a specific confectionery."
    },
    "/stores/{storeId}/orderItems/{itemId}": {
      "schema": "OrderItem",
      "description": "Line items associated with orders of a confectionery."
    },
    "/stores/{storeId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "CRM customer records isolated to a confectionery."
    }
  }
}
